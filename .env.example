# =============================================================================
# OPENCLAW TRIAD — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this to .env and fill in your credentials
# chmod 600 .env after copying
# NEVER commit .env to version control
# =============================================================================

# =============================================================================
# NANOGPT API (REQUIRED)
# =============================================================================
# Get your key at https://nano-gpt.com/api
# Single key grants access to all models (Claude, GPT, Gemini, etc.)
NANOGPT_API_KEY=your_nanogpt_api_key_here

# =============================================================================
# OPTIONAL: VOICE SYNTHESIS
# =============================================================================
# ElevenLabs for TTS (text-to-speech)
# Optional per-agent voice overrides available below
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=default_voice_id
ELEVENLABS_VOICE_ID_CLAWDIO=clawdio_specific_voice_id
ELEVENLABS_VOICE_ID_ARBITER=arbiter_specific_voice_id

# =============================================================================
# OPTIONAL: CHAT INTERFACE
# =============================================================================
# Telegram bot for direct agent communication
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=your_telegram_user_id

# =============================================================================
# OPTIONAL: LIVE TRADING
# =============================================================================
# Polymarket CLOB (Compliance Order Book) for real trading
# Omit these to stay in testnet mode with simulated trades
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_ASSET_ID=specific_asset_to_subscribe_to

# =============================================================================
# CRYPTO TREASURY (ONE CURRENCY ONLY)
# =============================================================================
# Choose ONE: btc (Bitcoin), xmr (Monero - recommended for privacy), or eth (Ethereum)
# The specified agent becomes the treasury custodian
# WARNING: Store private keys securely, NEVER commit to git

# Uncomment ONE of these blocks:

# --- Bitcoin ---
# WALLET_TYPE=btc
# WALLET_PRIVATE_KEY=your_bitcoin_private_key

# --- Monero (Privacy-focused) ---
# WALLET_TYPE=xmr
# WALLET_PRIVATE_KEY=your_monero_private_key

# --- Ethereum ---
# WALLET_TYPE=eth
# WALLET_PRIVATE_KEY=your_ethereum_private_key

# Which agent manages the treasury (default: clawdio)
WALLET_AGENT=clawdio

# =============================================================================
# MODEL OVERRIDES (OPTIONAL)
# =============================================================================
# By default: Clawdia=Sonnet (fast), Clawdio/Arbiter=Opus (deep reasoning)
# Override if you want different models for specific agents

CLAWDIA_MODEL=anthropic/claude-sonnet-4-6
CLAWDIO_MODEL=anthropic/claude-opus-4-6
ARBITER_MODEL=anthropic/claude-opus-4-6
UTILITY_MODEL=openai/gpt-5.4-mini

# Thinking depth (medium | high)
CLAWDIA_THINKING=medium
CLAWDIO_THINKING=high
ARBITER_THINKING=high

# =============================================================================
# DEPLOYMENT OPTIONS
# =============================================================================
# State directory (default: ~/.openclaw)
# Change if you want state elsewhere, e.g. /data/openclaw
# OPENCLAW_STATE_DIR=~/.openclaw

# Docker enablement (default: true when running with --docker flag)
DOCKER_ENABLE=true

# Container configuration (advanced)
CONTAINER_HOME=/home/openclaw
CONTAINER_STATE_DIR=/home/openclaw/.openclaw
BASE_IMAGE=python:3.11-slim
CONTAINER_MEM_LIMIT=1g
CONTAINER_CPUS=1.0

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. This file contains secrets — ensure it's in your .gitignore
# 2. Never share this file or commit it to repositories
# 3. Use a secrets manager in production environments
# 4. Rotate API keys regularly
# 5. Consider using hardware wallets for large crypto holdings
# =============================================================================