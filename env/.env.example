# ============================================================================
# OpenClaw Triad — .env.example
# ============================================================================
# Template ONLY — no real secrets. Copy to env/.env.real-secrets (or let
# `make secrets-save` snapshot your live .env) and fill in real values.
#
# Layout:
#   env/.env.example      ← this file (committable, shape only)
#   env/.env.real-secrets ← your REAL keys (gitignored, NEVER commit)
#
# The live copy the runtime uses is ~/.openclaw/.env (seeded from the stash
# by `make init` / restored by `make secrets-restore`).
#
# Generator version compatibility: setup-openclaw-triad.sh v3.3+
# ============================================================================

# ---------------------------------------------------------------------------
# SECRETS (required)
# ---------------------------------------------------------------------------

# NanoGPT API key — enables the nanogpt model provider wiring.
# Get one at https://nano-gpt.com — this drives ALL model traffic and spend.
NANOGPT_API_KEY=

# Gateway auth token. Auto-generated with random hex if left empty
# (`make setup` seeds one). Required for network-bound gateway access.
OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# ROSTER & PERSONALITY (required)
# ---------------------------------------------------------------------------

# Exactly 3 agents, comma-separated. Position defines the seat:
#   position 1 = SCOUT  (research + propose trades)
#   position 2 = RISK    (validate/veto; treasury custodian)
#   position 3 = JUDGE  (binding rulings; read-only by design)
# Per-agent overrides use the uppercased name: AGENT_<NAME>_MODEL etc.
# (note: names glue into one word — AGENT_THESOURCE_MODEL, not AGENT_THE_SOURCE)
AGENT_ROSTER=seer,guardian,sage

# Preset that shapes the agents' temperament and risk limits:
#   default | mystic | bold | conservative | quant
PERSONALITY_PRESET=mystic

# ---------------------------------------------------------------------------
# MODEL LINEUP (v3.3+ — change your lineup here, never in the scripts)
# ---------------------------------------------------------------------------
# Two spelling rules the generator enforces for you:
#   1. Catalog ids below are BARE ("vendor/model-id") — NanoGPT's API expects
#      these exactly as your subscription lists them.
#   2. References in the generated config are nanogpt/-prefixed — the router
#      expects that. You never write the prefix yourself.
#
# EVERY model referenced by any seat or the utility slot MUST appear in the
# catalog — the generator prints an ADVISORY if not, and the runtime may
# reject unknown models at transport time.

# Provider catalog: comma-separated. Optional display name after "|":
#   vendor/model-id|Display Name
# Example DeepSeek/GLM lineup (subscription without Claude/GPT):
# NANOGPT_MODEL_CATALOG=deepseek/deepseek-v4.1-flash-1017,z-ai/glm-5.3,z-ai/glm-5.3-flash-uncensored

# Seat assignment (position defaults). Example for the DeepSeek/GLM lineup:
#   fast scanner scouts; heavyweights guard and judge; flash on the bench.
# TRIAD_SCOUT_MODEL=deepseek/deepseek-v4.1-flash-1017
# TRIAD_RISK_MODEL=z-ai/glm-5.3
# TRIAD_JUDGE_MODEL=z-ai/glm-5.3
# UTILITY_MODEL=z-ai/glm-5.3-flash-uncensored

# Per-agent overrides — highest precedence, beat the seat defaults above:
# AGENT_SEER_MODEL=
# AGENT_GUARDIAN_MODEL=
# AGENT_ARBITER_MODEL=

# Reasoning effort per agent (default medium):
# AGENT_SEER_THINKING=medium

# ---------------------------------------------------------------------------
# TELEGRAM (optional)
# ---------------------------------------------------------------------------
# Bot token from @BotFather. Without this, no telegram wiring is emitted.
# The channel is registered AT RUNTIME, once, after first successful boot:
#   make telegram
# (or: docker exec -it openclaw-triad openclaw channels add telegram)
# TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of numeric Telegram user IDs (ask @userinfobot).
# Anyone not listed is silently ignored by the bot — by design.
# TELEGRAM_USER_ID=

# ---------------------------------------------------------------------------
# VOICES / TTS (optional)
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# INFRASTRUCTURE (rarely touched — sane defaults shown)
# ---------------------------------------------------------------------------
# Docker base image. FORCED to node:24-slim by the rebuild script regardless
# of what appears here (the python-base era is dead; do not resurrect it).
# BASE_IMAGE=node:24-slim

# openclaw runtime npm version (default: latest from the registry).
# OPENCLAW_VERSION=latest

# Emit Docker files on `make setup` (Makefile default is true).
# DOCKER_ENABLE=true

# Container ceilings. mem_limit is enforced at 3g by the rebuild script
# (exit 137 = OOM at 2g with 16 workers; keep headroom inside the 6 GB VM).
# CONTAINER_MEM_LIMIT=3g
# CONTAINER_CPUS=2

# Custodial wallet config for the risk seat (position 2). Testnet-only,
# env-sourced key, zero auto-withdrawal. Generated only when set:
#   --wallet btc | xmr | eth   (or WALLET_TYPE= in this file)
# WALLET_TYPE=
# WALLET_AGENT=

# ---------------------------------------------------------------------------
# REMINDERS
# ---------------------------------------------------------------------------
# - chmod 600 any file containing real secrets.
# - After editing the live .env: `make secrets-save` (persist to stash),
#   then `make setup` (regenerate config), then `make docker-up`.
# - The rebuild fetches Makefile + scripts/setup-openclaw-triad.sh from the
#   pinned tag; local edits to those files vanish until committed + tagged.
