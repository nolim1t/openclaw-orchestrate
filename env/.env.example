# =============================================================================
# OpenClaw Triad — example environment file
# Copy to: ~/.openclaw/.env   (usually done for you by `make init`)
# Then: chmod 600 ~/.openclaw/.env   (usually done for you by `make setup`)
#
# RULES OF THUMB
#   - Secrets live ONLY here. Never commit this file with real values.
#   - The generator never overwrites an existing .env — edit freely.
#   - Anything you don't set simply disables that feature.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Gateway auth token for network-bound access.
# If missing, `make setup` seeds a random one for you — check it here.
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# MODELS (NanoGPT provider — OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------

# Enables the nanogpt model provider wiring. Without it, agent configs
# reference models without the nanogpt/ prefix.
NANOGPT_API_KEY=

# --- Model lineup (v3.3+) ----------------------------------------------------
# Catalog ids are BARE "vendor/model-id" (what the NanoGPT API expects).
# Optional display name after "|". Every model referenced by the seat vars
# below should appear here — the generator prints a loud ADVISORY if not.
#
# Default lineup (used if unset):
# NANOGPT_MODEL_CATALOG=anthropic/claude-sonnet-4-6,anthropic/claude-opus-4-6,openai/gpt-5.4-mini
#
# Example with display names + budget lineup:
# NANOGPT_MODEL_CATALOG=deepseek/deepseek-v4.1-flash-1017|DeepSeek Flash,z-ai/glm-5.3|GLM 5.3,z-ai/glm-5.3-flash-uncensored|GLM 5.3 Flash Uncensored

# Per-seat default models (bare ids, no prefix). Override per agent below.
# TRIAD_SCOUT_MODEL=anthropic/claude-sonnet-4-6
# TRIAD_RISK_MODEL=anthropic/claude-opus-4-6
# TRIAD_JUDGE_MODEL=anthropic/claude-opus-4-6

# Shared utility/fallback model for all agents.
# UTILITY_MODEL=openai/gpt-5.4-mini

# Per-agent overrides — HIGHEST precedence (beats the seat vars above).
# Names derive from your AGENT_ROSTER (uppercase). With the default roster:
# AGENT_SEER_MODEL=
# AGENT_GUARDIAN_MODEL=
# AGENT_SAGE_MODEL=
# AGENT_<NAME>_THINKING=        # default: medium
# AGENT_<NAME>_VOICE=           # per-agent ElevenLabs voice id (when TTS on)

# -----------------------------------------------------------------------------
# THE TRIAD
# -----------------------------------------------------------------------------

# Exactly 3 names, comma-separated.
# Position 1 = scout/proposer · 2 = risk/veto (+ optional wallet) · 3 = judge/read-only
AGENT_ROSTER=seer,guardian,sage

# Persona + hard risk limits (positions %, daily loss %, trades/day).
# default | mystic | bold | conservative | quant
PERSONALITY_PRESET=default

# -----------------------------------------------------------------------------
# OPTIONAL WALLETS (testnet only — config ships mode:"testnet", zero auto-withdrawal)
# -----------------------------------------------------------------------------
# Set via `make setup -- --wallet TYPE` or:
# WALLET_TYPE=btc              # btc | xmr | eth
# WALLET_AGENT=guardian        # defaults to your position-2 agent

# -----------------------------------------------------------------------------
# TELEGRAM FRONT-END (optional)
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Enables the telegram plugin generation;
# the channel itself registers at runtime after first boot: make telegram
# TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of Telegram user ids who may talk to the agents.
# Empty = nobody (the bot stays silent even if the token leaks).
# TELEGRAM_USER_ID=

# -----------------------------------------------------------------------------
# VOICES (optional)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=default

# -----------------------------------------------------------------------------
# INFRASTRUCTURE (sane defaults — rarely touched)
# -----------------------------------------------------------------------------
# Emit Docker files (Dockerfile, docker-compose.yml, docker.env).
DOCKER_ENABLE=true

# Docker base image. The rebuild script enforces node:24-slim; don't fight it.
# BASE_IMAGE=node:24-slim

# npm version of the openclaw runtime.
# OPENCLAW_VERSION=latest

# Container ceilings (mem_limit was raised 2g -> 3g after measured rss 1.6GiB).
# CONTAINER_MEM_LIMIT=3g
# CONTAINER_CPUS=2

# --- Ollama (local LLM) ---------------------------------------------------
# OLLAMA_ONLY=1 forces ALL models (seats + utility) onto the local Ollama
# provider — testnet / CI mode. 0 = NanoGPT lineup (or builtin defaults).
# Models are attached one of two ways:
#
#   OLLAMA_EMBED=1  generator ships an `ollama` service INSIDE the compose
#                   stack (named volume, no published ports, DNS `ollama`).
#                   Recommended default. After first boot: make ollama-init
#                   to pull models.
#   OLLAMA_EMBED=0  you run your own daemon on the host; containers reach
#                   it via host-gateway at host.docker.internal:11434.
#
OLLAMA_ONLY=0
OLLAMA_EMBED=1

# Container-view Ollama endpoint. Generator defaults handle both modes
# (embedded -> http://ollama:11434/v1, host -> host.docker.internal).
# Only set this if Ollama runs on ANOTHER machine (LAN IP, not loopback).
# OLLAMA_BASE_URL=

# Per-seat ollama model ids (bare — no provider prefix).
# qwen3:0.6b ≈ 500MB  ·  qwen3:1.7b ≈ 1.4GB — CPU-friendly utility class.
# OLLAMA_SCOUT_MODEL=qwen3:1.7b
# OLLAMA_RISK_MODEL=qwen3:1.7b
# OLLAMA_JUDGE_MODEL=qwen3:1.7b
# OLLAMA_UTILITY_MODEL=qwen3:0.6b

# Embedded service tuning (defaults fine for ≤4B models).
# OLLAMA_IMAGE=ollama/ollama:0.40.10   # pin — bump deliberately
# OLLAMA_MEM_LIMIT=2g

# -----------------------------------------------------------------------------
# REMEMBER
#   Papers first. Testnet. Then small. The ledger is append-only.
# -----------------------------------------------------------------------------
